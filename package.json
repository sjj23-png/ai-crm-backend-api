{
  "name": "ai-crm-platform",
  "version": "1.0.0",
  "description": "AI CRM & Sales Automation Platform",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "node dist/apps/api/src/server.js",
    "build": "rimraf dist && tsc",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=database/prisma/schema.prisma",
    "prisma:format": "prisma format --schema=database/prisma/schema.prisma",
    "prisma:seed": "tsx database/prisma/seed.ts",
    "mcp:start": "node scripts/start-mcp.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.2",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.1",
    "generate": "^0.14.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^7.0.5",
    "npx": "^10.2.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "redis": "^5.8.2",
    "remixicon": "^4.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@prisma/client": "^6.19.3",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^7.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}
